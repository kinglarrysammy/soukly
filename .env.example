# Application
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8787
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-long-random-string
SESSION_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_NAME=soukly_session

# Database — use ONE of:
SOUKLY_DB=/tmp/soukly.db
# DATABASE_URL=postgresql://user:pass@host:5432/soukly

SOUKLY_PORT=8787

# Rate limits (per IP per window seconds)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_SEARCH=60
RATE_LIMIT_AGENT_REQUEST=20
RATE_LIMIT_LISTING_CREATE=30

# Object storage (optional until image upload goes live)
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_BASE=
MAX_UPLOAD_BYTES=5242880

# Future providers
# EMAIL_PROVIDER=
# WHATSAPP_TOKEN=
# AI_API_KEY=
# VOICE_API_KEY=

# Multi-instance rate limiting (optional)
REDIS_URL=

# Email delivery for password reset / verification (optional)
EMAIL_PROVIDER=
